# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage/
playwright-report/
test-results/

# next.js
/.next/
/out/
out/

# production
/build
build/
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# user uploads (giữ lại thư mục bằng .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# dữ liệu Docker nếu đổi sang bind mount (hiện docker-compose dùng named volume)
/pgdata/
/.docker-data/

# cấu hình cá nhân của Claude Code (.claude/rules/* là quy ước chung nên vẫn đưa lên)
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
CLAUDE.local.md

# editor / IDE (cấu hình cá nhân)
.vscode/
.idea/
*.swp
*.swo

# cache và file tạm
.eslintcache
.cache/
*.tmp
/tmp/
/scratch/
Desktop.ini

# ghi chú tiến độ cá nhân (chủ dự án tự theo dõi, không đưa lên repo)
docs/TODO.md
