# PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://fashion:fashion@localhost:5432/fashion?schema=public"

# Redis (docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth: tạo secret ngẫu nhiên, ví dụ: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tài khoản nhận chuyển khoản (trang quét VietQR). Mặc định là DỮ LIỆU MẪU — phải thay bằng tài khoản thật.
BANK_NAME="MB Bank (Quân Đội)"
BANK_BIN="970422"
BANK_ACCOUNT_NO="999988882026"
BANK_ACCOUNT_NAME="CONG TY TNHH FASHION STORE"

# VNPay (thanh toán thẻ). Để trống VNP_TMN_CODE/VNP_HASH_SECRET thì phương thức VNPAY bị khoá ở trang thanh toán.
# Đăng ký sandbox để lấy mã: https://sandbox.vnpayment.vn/devreg/ (xem README, mục "Thanh toán VNPay").
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# Bảo vệ route cron /api/cron/expire-orders (gửi header "Authorization: Bearer <CRON_SECRET>"). Để trống = route bị khoá.
CRON_SECRET=""

# (Tuy chon) In moi cau SQL cua Prisma khi dev: dat 1 de bat.
# PRISMA_QUERY_LOG=1

# ───────── AI (giai đoạn sau; xem docs/ai/07-env-and-setup.md). Bỏ comment khi bắt đầu làm AI. ─────────
# AI_ENABLED="false"                     # công tắc tổng; false = chỉ tìm kiếm từ khoá
# AI_PROVIDER="anthropic"                # anthropic | openai | google (tuỳ quyết định chốt)
# AI_API_KEY=""                          # khoá LLM (tuyệt đối không commit, không đặt NEXT_PUBLIC_)
# AI_CHAT_MODEL=""                       # model hội thoại + tool calling (điền id đúng của nhà cung cấp)
# AI_FAST_MODEL=""                       # model rẻ cho bước trích bộ lọc (tuỳ chọn)
# AI_EMBEDDING_PROVIDER=""               # có thể khác AI_PROVIDER (Anthropic không có API embedding)
# AI_EMBEDDING_API_KEY=""
# AI_EMBEDDING_MODEL=""
# AI_EMBEDDING_DIMENSIONS="1536"         # phải khớp vector(N) trong bảng ProductEmbedding
# AI_REQUEST_TIMEOUT_MS="15000"          # quá hạn thì dùng fallback tìm kiếm từ khoá
# AI_MAX_INPUT_CHARS="1000"
# AI_MAX_OUTPUT_TOKENS="800"
# AI_MAX_TOOL_STEPS="5"
# AI_RATE_LIMIT_PER_MINUTE="10"          # theo user (AI cần đăng nhập nên không có hạn mức riêng cho khách)
# AI_DAILY_TOKEN_BUDGET_PER_USER="50000"
# AI_DAILY_TOKEN_BUDGET_TOTAL="2000000"
# AI_LOG_LEVEL="0"                       # 0 chỉ số kỹ thuật | 1 tham số đã che PII | 2 toàn văn (chỉ khi đánh giá)
