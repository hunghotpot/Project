# PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://fashion:fashion@localhost:5432/fashion?schema=public"

# Redis (docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth: tạo secret ngẫu nhiên, ví dụ: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tài khoản nhận chuyển khoản (trang quét VietQR). Mặc định là DỮ LIỆU MẪU — phải thay bằng tài khoản thật.
BANK_NAME="MB Bank (Quân Đội)"
BANK_BIN="970422"
BANK_ACCOUNT_NO="999988882026"
BANK_ACCOUNT_NAME="CONG TY TNHH SPORT BRAND"

# VNPay (thanh toán thẻ). Để trống VNP_TMN_CODE/VNP_HASH_SECRET thì phương thức VNPAY bị khoá ở trang thanh toán.
# Đăng ký sandbox để lấy mã: https://sandbox.vnpayment.vn/devreg/ (xem README, mục "Thanh toán VNPay").
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# Bảo vệ route cron /api/cron/expire-orders (gửi header "Authorization: Bearer <CRON_SECRET>"). Để trống = route bị khoá.
CRON_SECRET=""

# (Tuy chon) In moi cau SQL cua Prisma khi dev: dat 1 de bat.
# PRISMA_QUERY_LOG=1
