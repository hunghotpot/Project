# PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://fashion:fashion@localhost:5432/fashion?schema=public"

# Redis (docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth: tạo secret ngẫu nhiên, ví dụ: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tài khoản nhận chuyển khoản (trang quét VietQR). Mặc định là DỮ LIỆU MẪU — phải thay bằng tài khoản thật.
BANK_NAME="MB Bank (Quân Đội)"
BANK_BIN="970422"
BANK_ACCOUNT_NO="999988882026"
BANK_ACCOUNT_NAME="CONG TY TNHH FASHION STORE"

# VNPay (thanh toán thẻ). Để trống VNP_TMN_CODE/VNP_HASH_SECRET thì phương thức VNPAY bị khoá ở trang thanh toán.
# Đăng ký sandbox để lấy mã: https://sandbox.vnpayment.vn/devreg/ (xem docs/features.md, mục "Thanh toán VNPay").
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# Bảo vệ route cron /api/cron/expire-orders (gửi header "Authorization: Bearer <CRON_SECRET>"). Để trống = route bị khoá.
CRON_SECRET=""

# (Tuy chon) In moi cau SQL cua Prisma khi dev: dat 1 de bat.
# PRISMA_QUERY_LOG=1

# ───────── Trợ lý AI (TUỲ CHỌN) ─────────
# Chạy hoàn toàn local qua Ollama, không cần API key. Cách cài Ollama, tải model, nạp embedding: README (mục "Trợ lý AI") và docs/ai/07-env-and-setup.md.
# Mặc định TẮT: để nguyên các dòng dưới (đang là comment) thì web chạy bình thường, chỉ không có trợ lý và tìm kiếm ngữ nghĩa.
# Muốn bật: bỏ comment 6 dòng đánh dấu [BẮT BUỘC] (giá trị mẫu đã đúng cho Ollama local); các dòng còn lại có mặc định, chỉ bỏ comment khi muốn đổi.
# Thiếu hoặc sai cấu hình thì AI tự tắt kèm lý do trong log, không làm hỏng build. Giá trị mẫu là cấu hình đã dùng khi phát triển (RTX 3050 6 GB).
# AI_ENABLED="true"                      # [BẮT BUỘC] công tắc tổng; false hoặc bỏ trống = chỉ tìm kiếm từ khoá, ẩn nút trợ lý
# AI_PROVIDER="ollama"                   # [BẮT BUỘC]
# AI_BASE_URL="http://localhost:11434"   # địa chỉ máy chủ Ollama (chỉ đọc ở server)
# AI_CHAT_MODEL="qwen3:4b-instruct"      # [BẮT BUỘC] model hội thoại + tool calling (bản không suy nghĩ)
# AI_FAST_MODEL="qwen3:4b-instruct"      # mặc định dùng chung model chat để chỉ một model nằm trong VRAM
# AI_EMBEDDING_PROVIDER="ollama"         # [BẮT BUỘC]
# AI_EMBEDDING_MODEL="bge-m3"            # [BẮT BUỘC]
# AI_EMBEDDING_DIMENSIONS="1024"         # [BẮT BUỘC] phải khớp vector(N) trong bảng ProductEmbedding/KnowledgeChunk
# AI_REQUEST_TIMEOUT_MS="60000"          # model local nạp lần đầu chậm; quá hạn thì dùng fallback tìm kiếm từ khoá
# AI_MAX_INPUT_CHARS="1000"
# AI_MAX_OUTPUT_TOKENS="800"
# AI_MAX_TOOL_STEPS="3"
# AI_RATE_LIMIT_PER_MINUTE="10"          # theo người dùng (AI cần đăng nhập)
# AI_DAILY_TOKEN_BUDGET_PER_USER="50000" # tuỳ chọn: trần token mỗi người mỗi ngày; bỏ trống = không giới hạn
# AI_DAILY_TOKEN_BUDGET_TOTAL="2000000"  # tuỳ chọn: trần token cả hệ thống mỗi ngày; bỏ trống = không giới hạn
# AI_LOG_LEVEL="0"                       # nhật ký hội thoại (xem bằng `npm run ai:logs`): 0 số liệu | 1 thêm tham số tool đã che PII | 2 thêm toàn văn (chỉ khi gỡ lỗi)
