// Fashion E-Commerce — Prisma schema.
// Tiền tệ: VND, lưu Int (không có phần thập phân).
// Extension `vector` đã được bật qua migration; CHƯA có cột embedding (sẽ thêm ở giai đoạn AI).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

// Ai thực hiện thay đổi trạng thái đơn.
enum OrderActorType {
  CUSTOMER
  ADMIN
  SYSTEM // job/cổng thanh toán (IPN), không gắn với user nào
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
  VNPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE) // LOCKED: Admin khoá, không đăng nhập/refresh được
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses          Address[]
  cart               Cart?
  orders             Order[]
  refreshTokens      RefreshToken[]
  orderStatusChanges OrderStatusHistory[]
  aiChatLogs         AiChatLog[]
}

// Refresh token opaque: chỉ lưu SHA-256 của token (không lưu token gốc).
// Mỗi lần refresh sẽ rotate: token cũ bị revoke, token mới cùng familyId.
// Token đã revoke mà bị dùng lại => coi là bị đánh cắp, revoke cả family.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  ward      String
  district  String
  province  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────── Catalog ────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())

  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  sizeCharts SizeChart[]

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String
  material    String
  style       String // casual | formal | streetwear | smart-casual | minimalist | vintage | sporty | korean | elegant | bohemian ...
  occasion    String[]
  season      String[]
  gender      Gender
  tags        String[]
  basePrice   Int // VND
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false) // hiển thị ở mục "Nổi bật" trang chủ
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  variants  ProductVariant[]
  embedding ProductEmbedding?

  @@index([categoryId, isActive])
  @@index([isActive, basePrice])
  @@index([isActive, isFeatured])
  @@index([gender])
  @@index([style])
  @@index([brand])
  @@index([occasion], type: Gin)
  @@index([season], type: Gin)
  @@index([tags], type: Gin)
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  size      String
  color     String // tên hiển thị tiếng Việt, ví dụ "Đen", "Xanh navy"
  colorHex  String
  price     Int // VND
  stock     Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([size])
  @@index([color])
}

// Vector ngữ nghĩa của sản phẩm cho Semantic Search (docs/ai/01-data-for-ai.md mục 3).
// Cột `embedding` là vector(1024) theo bge-m3; Prisma Client không đọc/ghi kiểu này nên dùng $queryRaw / $executeRaw.
// Chỉ mục HNSW (vector_cosine_ops) nằm trong file migration vì Prisma không biểu diễn được.
model ProductEmbedding {
  productId       String   @id
  embedding       Unsupported("vector(1024)")
  content         String // đúng chuỗi đã embed
  contentHash     String // sha256(content | model | templateVersion)
  model           String
  dimensions      Int
  templateVersion Int      @default(1)
  embeddedAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Đoạn kiến thức (chăm sóc, size, chính sách, phối đồ) nạp từ docs/ai/knowledge/*.md cho RAG (docs/ai/03-rag-advisor.md mục 1).
// Khoá tự nhiên là (source, title). `embedding` là vector(1024) theo bge-m3; chỉ đọc/ghi bằng SQL thô như ProductEmbedding.
// Không có chỉ mục vector: vài chục đoạn thì quét tuần tự đã đủ nhanh và tránh thêm lệch schema với Prisma.
model KnowledgeChunk {
  id              String   @id
  source          String // tên file nguồn, ví dụ "care.md"
  type            String // care | styling | policy | faq
  title           String
  content         String
  metadata        Json
  embedding       Unsupported("vector(1024)")
  contentHash     String // sha256(tiêu đề + nội dung | model | templateVersion): đổi thì phải embed lại
  model           String
  templateVersion Int      @default(1)
  updatedAt       DateTime @default(now())

  @@unique([source, title])
  @@index([type])
}

// Nhật ký một lượt chat với trợ lý (docs/ai/05-safety-and-guardrails.md mục 7). Mức 0 luôn ghi số liệu kỹ thuật và tên tool;
// `params` chỉ có ở mức 1 trở lên (đã che PII); `userText`/`replyText` chỉ có ở mức 2 và bị xoá sau vài ngày (purge).
model AiChatLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  level      Int
  model      String
  status     String // ok | fallback | error | bare_confirmation
  claim      String? // lý do cổng kiểm chứng can thiệp (catalog, size, order...), nếu có
  retries    Int      @default(0)
  latencyMs  Int
  ttftMs     Int?
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  tools      Json // [{ name, ok, code?, ms }]
  params     Json? // [{ name, input }] đã che PII (mức >= 1)
  error      String?
  userText   String? // mức 2
  replyText  String? // mức 2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Số đo tham chiếu (cm / kg) phục vụ tư vấn size bằng AI.
// brand = null: bảng size chung; có brand: bảng riêng của thương hiệu đó.
model SizeChart {
  id         String  @id @default(cuid())
  categoryId String
  brand      String?
  size       String
  chest      Int? // vòng ngực (cm) — null với quần
  waist      Int // vòng eo (cm)
  hip        Int // vòng mông (cm)
  heightMin  Int // cm
  heightMax  Int
  weightMin  Int // kg
  weightMax  Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, brand])
}

// ─────────────────────────── Cart & Order ───────────────────────────

// Giỏ của user đã đăng nhập, mỗi user một giỏ. Không có giỏ khách (cần tài khoản để dùng giỏ hàng).
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int      @default(1)
  priceAtAdd Int? // VND, giá lúc thêm/sửa gần nhất — để cảnh báo khi giá đổi. null = không rõ.
  createdAt  DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// Bộ đếm số thứ tự đơn theo ngày (day = YYYYMMDD, giờ Việt Nam) → mã đơn FS-YYYYMMDD-0001.
// Tăng bằng upsert increment trong transaction nên hai đơn đồng thời không trùng mã.
model OrderSequence {
  day  String @id
  last Int
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique // mã dễ đọc, vd FS-20261109-0001
  userId          String
  status          OrderStatus   @default(PENDING)
  subtotal        Int // VND, tổng tiền hàng
  shippingFee     Int           @default(0) // VND
  total           Int // VND, = subtotal + shippingFee tại thời điểm đặt
  note            String?
  shippingAddress Json // snapshot địa chỉ giao hàng
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status])
}

// Nhật ký mỗi lần đổi trạng thái đơn (kể cả lúc tạo đơn: fromStatus = null) → dựng timeline.
model OrderStatusHistory {
  id          String         @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderActorType
  actorUserId String? // null khi SYSTEM; SetNull nếu user bị xoá
  note        String? // lý do huỷ, nguồn thay đổi (vd "Thanh toán VNPay thành công")
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// Snapshot tại thời điểm mua: sửa/xoá sản phẩm sau này không làm đổi đơn cũ.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String? // giữ tham chiếu để thống kê; null nếu variant bị xoá
  productName String
  sku         String
  size        String
  color       String
  unitPrice   Int // VND
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}
